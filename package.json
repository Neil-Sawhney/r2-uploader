{
  "name": "r2-uploader",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "vite --port 7896",
    "dev": "vite --port 7896",
    "dev:vite": "vite --port $PORT",
    "dev:vercel": "vercel dev -l 7896",
    "build:setup": "cp README.md public/setup-guide/index.md && node public/setup-guide/gen_markdown.js",
    "build": "npm run build:setup && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 7896",
    "deploy": "npm run build && npm run cf:deploy",
    "cf:deploy": "wrangler deploy --assets=./dist",
    "deploy:vercel": "npm run build:setup && vercel --prod",
    "clean": "rm -rf dist",
    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.7",
    "baseline-browser-mapping": "^2.10.0",
    "bun-types": "^1.1.29",
    "caniuse-lite": "^1.0.30001775",
    "compressorjs": "^1.2.1",
    "crypto-js": "^4.2.0",
    "marked": "^9.1.6",
    "mongodb": "^6.9.0",
    "nanoid": "^4.0.2",
    "pinia": "^2.2.2",
    "postcss": "^8.4.47",
    "qrcode": "^1.5.4",
    "sass": "^1.79.3",
    "tailwindcss": "^3.4.13",
    "vue": "^3.5.8"
  },
  "devDependencies": {
    "@vercel/node": "^5.6.9",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.8",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.40.0"
  }
}
